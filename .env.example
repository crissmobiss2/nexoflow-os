# PostgreSQL database URL
# Free option: https://neon.tech (Neon serverless Postgres — free tier available)
DATABASE_URL="postgresql://user:password@host/nexoflow_os?sslmode=require"

# Anthropic API key — https://console.anthropic.com
ANTHROPIC_API_KEY="sk-ant-..."

# Path to your NexoFlow second brain vault (used to load playbooks + standards as AI context)
SECOND_BRAIN_PATH="C:/NexoFlow Second-Brain/second-brain"
